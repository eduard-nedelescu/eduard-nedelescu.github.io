---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
    title,
    description = "Personal website of George-Eduard NEDELESCU."
} = Astro.props;
---

<!doctype html>

<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />

        <meta name="description" content={description} />

        <title>{title} | George-Eduard NEDELESCU</title>
    </head>

    <body>
        <Navigation />

        <main>
            <slot />
        </main>

        <Footer />
    </body>
</html>